# be_clinic (PORT=8011, tiền tố /api/v1). Đăng ký OTP: xem log console backend để lấy mã 6 số (dev).
#
# Khuyến nghị dev: tự lấy IP từ Expo/Metro (tránh IP cũ khi đổi mạng)
EXPO_PUBLIC_API_AUTO=1
EXPO_PUBLIC_API_PORT=8011
#
# Ghi đè thủ công (đặt EXPO_PUBLIC_API_AUTO=0):
# EXPO_PUBLIC_API_URL=http://localhost:8011
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8011
# EXPO_PUBLIC_API_URL=http://<IPv4-máy-dev>:8011
# Bật 1 khi chưa có backend AI — app trả lời mock thay vì gọi /api/v1/ai/chat
# EXPO_PUBLIC_AI_MOCK=1
