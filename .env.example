# be_clinic (mặc định PORT=5000). Đăng ký OTP: xem log console backend để lấy mã 6 số (dev).
#
# Khuyến nghị dev: tự lấy IP từ Expo/Metro (tránh IP cũ khi đổi mạng)
EXPO_PUBLIC_API_AUTO=1
#
# Ghi đè thủ công (đặt EXPO_PUBLIC_API_AUTO=0):
# EXPO_PUBLIC_API_URL=http://localhost:5000
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# EXPO_PUBLIC_API_URL=http://<IPv4-máy-dev>:5000
# Bật 1 khi chưa có backend AI — app trả lời mock thay vì gọi /api/ai/chat
# EXPO_PUBLIC_AI_MOCK=1
