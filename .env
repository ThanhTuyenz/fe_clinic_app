# be_clinic (mặc định PORT=5000). Đăng ký OTP: xem log console backend để lấy mã 6 số (dev).
#
# Dev trên điện thoại / Expo Go: AUTO=1 tự lấy IP từ Metro (không cần sửa khi đổi Wi-Fi).
EXPO_PUBLIC_API_AUTO=1
#
# Ghi đè thủ công (đặt EXPO_PUBLIC_API_AUTO=0 nếu dùng các dòng dưới):
# Chỉ máy tính dev / simulator: EXPO_PUBLIC_API_URL=http://localhost:5000
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# Điện thoại thật (ipconfig → IPv4): EXPO_PUBLIC_API_URL=http://192.168.1.254:5000
