# be_clinic (mặc định PORT=5000). Đăng ký OTP: xem log console backend để lấy mã 6 số (dev).
# Chỉ máy tính dev: EXPO_PUBLIC_API_URL=http://localhost:5000
# Thử trên điện thoại cùng Wi-Fi: thay bằng IPv4 máy dev (ipconfig), ví dụ:
# EXPO_PUBLIC_API_URL=http://192.168.2.26:5000
# Android emulator trỏ về máy host: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
EXPO_PUBLIC_API_URL=http://192.168.2.26:5000
